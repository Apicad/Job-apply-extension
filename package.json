{
  "name": "job-apply-extension",
  "description": "Chrome extension that fills job application forms from your saved profile. You review and submit.",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && node scripts/e2e.mjs",
    "fixtures": "vite --config tests/fixtures/vite.config.ts --open",
    "check": "npm run compile && npm run test && npm run test:native && npm run test:e2e",
    "postinstall": "wxt prepare",
    "test:native": "node --test tests/native/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
